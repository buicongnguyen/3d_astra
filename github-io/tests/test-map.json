    {
      "name": "story, campaign and chronicles",
      "files": ["src/story/**", "src/mission-text.js", "src/mission-ui.js", "src/mission-ui.css", "src/mission-look*.js", "src/mission-looks.js", "src/campaign*.js", "src/campaign*.css", "src/campaign-maps.json", "src/chronicles*", "src/choices.css", "src/scenes.css", "src/openings.css", "src/title-card.css", "src/unit-intros.js", "src/cast-portraits.js", "src/app/{briefing,choices,scenes,title-card}.js", "src/art/campaign/**"],
