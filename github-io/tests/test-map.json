      "suites": ["layout-f", "status-layout", "ui-quality", "phones", "iphone-gestures", "readability", "mobile", "mobile-controls", "ui-extras", "messages", "cover-ui", "settings-sheet", "language", "tactics-ui", "mobile-construction", "support-touch", "faction-depth", "progression", "ceremony", "quick-battle", "rank", "portraits", "fullscreen"],
      "checks": []
