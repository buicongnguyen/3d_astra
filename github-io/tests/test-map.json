{
  "about": [
    "Which checks cover which files, for `npm run test:changed` (tests/changed.mjs). Paths are relative to github-io/;",
    "a path outside github-io/ starts with ../ (for example ../.github/**). Globs: ** any folders, * within a name, {a,b} either.",
    "Every rule whose files match a changed path adds its suites (browser suites by script name, `npm run test:<name>`)",
    "and its checks (npm scripts). \"suites\": \"all\" means the whole CI matrix. A changed browser suite tests/<name>.mjs",
    "always runs itself. A changed path that no rule matches runs the whole matrix (safe default), and",
    "tests/test-map.test.js fails while any file under src/, public/ or tests/ matches no rule: add the new file here.",
    "The `always` suites run on every change as a smoke check. CI ignores this file: it always runs the full matrix."
  ],
  "always": ["browser", "title"],
  "rules": [
    {
      "name": "docs and notes (nothing to run)",
      "files": ["**/*.md", "../*.md", "../docs/**", "../skills/**", "../music-lab/**", "../LICENSE", "docs/**", "public/prompt/**", "tools/blender/**", "tools/*.py", "tools/{look-shots,kit-shots,fx-strips,review-wyrms,perf-ab,perf-phone,vfx-phone-bench,first-visit,phone-hud-audit,render-audio,port-boss-model,faction-bench,faction-matrix,skirmish-bench,high-ground-bench,wild-bench,first-contact,baseline-diff,defence-coverage}.mjs", "tools/boss-parts/**"],
      "suites": [],
      "checks": []
    },
    {
      "name": "build, workflow, shared test code, test hooks and the frame loop (everything)",
      "files": ["package.json", "package-lock.json", "vite.config.js", "index.html", "../.github/**", "../.gitattributes", "../.gitignore", ".gitignore", "tests/lib/{harness,ci-like,ci-matrix,settings-sheet,client-source,client-wiring}.mjs", "tests/lib/client-source.js", "tests/ci-local.mjs", "tests/serve-build.mjs", "src/main.js", "src/app/{frame,state,debug-hooks,match-flow,shell,screens,dom,preferences}.js", "src/settings-ui.js", "src/settings.js", "src/i18n.js", "src/view.js", "src/view-plugins.js", "src/style.css", "src/ui-kit.css", "src/ui-theme.css", "src/kit-skin.css", "src/theme-walnut.css", "src/theme-switch.js", "src/fonts/**", "tools/sw.template.js"],
      "suites": "all",
      "checks": []
    },
    {
      "name": "test tooling with its own check",
      "files": ["tests/changed.mjs", "tests/test-map.json", "tests/*.test.js", "tests/lib/{sim.js,golden.mjs,duel.mjs,map-fingerprint.mjs,sovereign.mjs}", "tests/fixtures/r3-base-menu-controls.json"],
      "suites": [],
      "checks": []
    },
    {
      "name": "the shard helper (suites split over CI jobs)",
      "files": ["tests/lib/shard.mjs"],
      "suites": ["render-budget", "language"],
      "checks": []
    },
    {
      "name": "rules: the simulation, data and saves",
      "files": ["src/sim/**", "src/simulation.js", "src/snapshot.js", "src/savegame.js", "src/balance.json", "src/data.js", "src/factions.js", "src/rng.js", "src/commands.js", "src/navigation.js", "src/terrain.js", "src/maps.json", "src/ai-plan.js", "src/difficulty.js", "src/model-roster.js", "src/match-stats.js", "src/activity.js", "src/abilities*.js", "src/ceremony-rules.js", "src/audio-logic.js", "src/type-chips-model.js", "tools/{playbot,mission-check,chronicle-check,defence-bot,defence-check,ai-census-check,difficulty-check}.mjs", "tools/story-strings.mjs"],
      "suites": ["auto-combat", "harvesters", "missions", "defence", "quick-battle-check", "ai-census-check", "defence-heroic-check", "factions", "terrain", "squad-orders", "creatures", "boss", "air", "sovereign-walks", "stages", "new-game", "army-depth", "workshops", "gunner", "faction-depth", "wild-desert", "patrol", "repair-rally", "activity", "golden-full"],
      "checks": ["check:missions", "check:defence"]
