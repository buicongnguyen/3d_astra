      "files": ["src/*-view.js", "src/entity-batches.js", "src/fx.js", "src/fx-*.{js,json}", "src/fx-kinds/**", "src/ground-paint.js", "src/scatter.js", "src/look-grade.*", "src/night-sky.js", "src/unit-rig.js", "src/governor.js", "src/transform-cache.js", "src/ambient-life.js", "src/ambience.js", "src/plateau-relief.js", "src/terrain-labels.js", "src/map-edge.js", "src/team-bands.js", "src/threat-arrows.js", "src/visual-style.*", "src/faction-colors.js", "src/camera-shake.js", "src/combat-feedback.js", "src/air-motion.js", "src/air-hint.js", "src/fog-aware.js", "src/building-decals-atlas.js", "src/elite-view.js", "public/models/**", "public/fx/**", "public/portraits/**"],
      "suites": ["render-budget", "visual-combat", "feel", "model-loading", "ambient-life", "boundary-fx", "night-storm", "readability", "factions", "terrain", "air", "creatures", "boss", "wild-desert", "corners", "portraits", "selection"],
      "checks": []
